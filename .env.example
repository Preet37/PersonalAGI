# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- LLM ---------------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gmail ingest ------------------------------------------------------
# Comma-separated account labels. Each label maps to a token file at
# tokens/<label>.json, authorized separately via scripts/gmail_auth.py.
# Read-only scope: https://www.googleapis.com/auth/gmail.readonly
GMAIL_ACCOUNTS=personal,work,school
GOOGLE_CREDENTIALS_PATH=credentials/credentials.json
TOKENS_DIR=tokens

# --- Identity ----------------------------------------------------------
# Your own addresses, comma-separated. Commitment direction depends on this:
# a promise inside mail YOU sent is one you made; the same sentence in mail you
# received is one you were given. `relevance` refuses to run without it rather
# than guessing, because guessing would file every promise on the wrong side.
OWNER_EMAILS=you@example.com
OWNER_NAME=Your Name

# Days without follow-up before an open commitment is reported stale.
COMMITMENT_STALE_DAYS=7

# --- Storage -----------------------------------------------------------
# The markdown vault. Source of truth; gitignored.
CONTEXT_DIR=context
# Derived FTS5 index. Safe to delete and rebuild from CONTEXT_DIR.
DATABASE_URL=sqlite:///data/personalagi.db

# --- Ingest tuning -----------------------------------------------------
# First run has no watermark. Bounds the initial pull so a first `ingest`
# does not walk your entire mailbox.
INITIAL_BACKFILL_DAYS=30
# Safety window subtracted from the date watermark, in seconds. Mail is not
# delivered in internalDate order, so a strict boundary drops late arrivals.
# Costs a little quota, never correctness — re-inserts are deduped.
INGEST_OVERLAP_SECONDS=86400
# 0 = no cap. Set low for a cautious first run.
INGEST_MAX_MESSAGES=0

# --- API ---------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
